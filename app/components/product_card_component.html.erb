<li
  class="product-card paper-card w-full px-3.5 py-4 <%= additional_classes %>"
  itemscope
  itemtype="http://schema.org/Product"
  id="product_<%= product.id %>"
>
  <span class="tape" aria-hidden="true"></span>
  <article class="h-full flex flex-col gap-2.5">
    <section class="product-card_image aspect-square overflow-hidden flex items-center justify-center border-2 border-dashed border-ink bg-well">
      <%= link_to product_path(product), itemprop: 'url', class: 'flex items-center justify-center w-full h-full' do %>
        <%= render(
          ImageComponent.new(
            image: main_image,
            size: :small,
            itemprop: "image",
            classes: 'w-full h-full object-contain'
          )
        ) %>
      <% end %>
    </section>
    <section class="flex flex-col gap-1.5 text-ink">
      <header class="product-card_header font-hand text-[32px] leading-none">
        <span>
          <%= link_to(
            truncate(product.name, length: 50),
            product_path(product),
            class: 'info hover:underline underline-offset-4',
            itemprop: "name",
            title: product.name
          ) %>
        </span>
      </header>
      <section
        class="product-card_price price-pen text-[17px]"
        itemprop="offers"
        itemscope
        itemtype="http://schema.org/Offer"
      >
        <% if display_price %>
          <span class="price selling" itemprop="price" content="<%= display_price.to_d %>">
            <%= display_price.to_html %>
          </span>
          <span itemprop="priceCurrency" content="<%= display_price.currency %>"></span>
        <% end %>
      </section>
    </section>
  </article>
</li>

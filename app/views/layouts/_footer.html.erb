<footer class="border-t-[3px] border-dashed border-ink bg-paper dark:bg-black dark:border-sand">
  <div class="wrapper pt-7 pb-9">
    <div class="flex flex-wrap items-center justify-between gap-5">
      <div class="flex flex-col gap-1.5">
        <span class="font-serif text-[20px] leading-[1.5]"><%= current_store.name %></span>
        <% if current_store.meta_description.present? %>
          <span class="text-[15px]"><%= current_store.meta_description %></span>
        <% end %>
      </div>
      <div class="flex items-center gap-[18px]" aria-hidden="true">
        <svg class="w-[34px] h-[34px]" viewBox="0 0 24 24"><path d="M12 20.5 C6 16 2.8 12.6 3.2 8.6 C3.6 5.2 7.6 3.8 10 6 C11 6.9 11.6 8 12 8.8 C12.6 7.4 13.6 5.6 15.6 5 C18.6 4.2 21.4 6.6 20.8 10 C20.2 13.6 16.4 17 12 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
        <svg class="w-[34px] h-[34px]" viewBox="0 0 24 24"><path d="M12 2.5 L17.8 20.5 L2.6 9.4 L21.4 9.6 L6.1 20.8 L12.4 3.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></path></svg>
        <svg class="w-[34px] h-[34px]" viewBox="0 0 24 24"><path d="M14 2.5 L6 13.2 L11.6 13 L9.4 21.5 L18 10.4 L12.4 10.6 Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
      </div>
      <%= link_to "Visit Solidus.io", "https://solidus.io", target: "_blank", class: "text-body-sm text-bic underline hover:text-ink dark:text-sand" %>
    </div>
    <%
      available_locales = current_store.available_locales.map do |locale|
        [
          I18n.t('spree.i18n.this_file_language',
          locale: locale,
          default: locale.to_s,
          fallback: false), locale
        ]
      end.sort
    %>
    <% if available_locales.many? %>
      <div class="locale-selector mt-6 max-w-xs" data-controller="locale-selector">
        <%= form_tag select_locale_path do %>
          <div class="locale-selector__select-input select-input">
            <%= label_tag :switch_to_locale, "#{t('spree.i18n.language')}:" %>
            <%= select_tag(:switch_to_locale, options_for_select(available_locales, I18n.locale), data: { action: "locale-selector#submitForm", "locale-selector-target" => "selector" }) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</footer>

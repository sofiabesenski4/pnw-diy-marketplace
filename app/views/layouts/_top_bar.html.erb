<div class="relative flex items-center" data-controller="top-bar">
  <div class="flex items-center gap-x-2 sm:gap-x-3 lg:gap-x-5 font-bold uppercase tracking-[.05em]">
    <%= render 'shared/search/search_bar', taxons: taxons, taxon: taxon, :locals => { :additional_classes => 'hidden lg:flex' } %>
    <div class="hidden lg:flex">
      <%= render "shared/navigation/theme_switcher" %>
    </div>

    <div class="relative">
      <%= link_to spree_current_user ? account_path : login_path, title: spree_current_user ? 'Account' : 'Login', class: 'flex items-center min-h-[44px] text-ink dark:text-sand hover:underline underline-offset-4' do %>
        <svg class='w-6 h-6 fill-current sm:hidden' aria-hidden="true">
          <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-user-line"></use>
        </svg>
        <span class="hidden sm:inline"><%= spree_current_user ? t('spree.my_account') : t('spree.login') %></span>
      <% end %>
    </div>

    <div id="link-to-cart" class="relative" data-top-bar-target="cartLink">
      <noscript>
        <%= link_to t('spree.cart'), cart_path %>
      </noscript>
    </div>
  </div>
</div>

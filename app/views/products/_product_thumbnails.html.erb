<% thumbnails_class = "flex shrink-0 w-[76px] h-[76px] justify-center items-center p-1.5 bg-well border-2 border-ink rounded-[3px_8px_4px_9px] transition-colors duration-150 hover:bg-white" %>

<div>
  <ul class="flex flex-wrap gap-3.5">
    <% unless product.has_variants? %>
      <% product.gallery.images.each do |image| %>
        <% next if image.viewable_id != product.master.id %>

        <%= content_tag(
          :li,
          data: { js: 'product-thumbnail', js_id: image.viewable_id }
        ) do %>
          <%= link_to image.url(:product), class: thumbnails_class do %>
            <%= image_tag(image.url(:small))  %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if product.has_variants? %>
      <% product.gallery.images.each do |image| %>
        <% next if image.viewable_id == product.master.id %>

        <%= content_tag(
          :li,
          data: { js: 'variant-thumbnail', js_id: image.viewable_id }
        ) do %>
          <%= link_to image.url(:product), class: thumbnails_class do %>
            <%= image_tag(image.url(:small))  %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </ul>
</div>


<% promotions = product.possible_promotions %>

<% if promotions.any? %>
  <section class="product-promotions sticky-note self-start flex flex-col gap-2 px-[18px] py-3">
    <h2 class="label-caps"><%= t('spree.promotions') %></h2>

    <% promotions.each do |promotion| %>
      <article>
        <header>
          <h3 class="font-hand text-[26px] leading-none"><%= promotion.name %></h3>
        </header>

        <p><%= promotion.description %></p>

        <% if promotion.products.any? %>
          <ul>
            <% promotion.products.each do |product| %>
              <li><%= link_to product.name, product_path(product) %></li>
            <% end %>
          </ul>
        <% end %>
      </article>
    <% end %>
  </section>
<% end %>

<div class="paper-card shadow-ink-lg -rotate-[1.2deg] p-[18px]">
  <span class="tape left-7 ml-0 -top-3.5 w-[104px] h-7 -rotate-[8deg]" aria-hidden="true"></span>
  <span class="tape left-auto right-6 ml-0 -top-3 w-[104px] h-7 rotate-[7deg]" aria-hidden="true"></span>
  <picture class="flex justify-center items-center w-full aspect-square overflow-hidden border-2 border-dashed border-ink bg-well">
    <%= render(ImageComponent.new(
      image: product.gallery.images.first,
      size: :product,
      itemprop: "image",
      data: { js: 'product-main-image' },
      class: 'w-full h-full object-contain'
    )) %>
  </picture>
</div>

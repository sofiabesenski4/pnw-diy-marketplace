<% dl_classes = 'flex items-center justify-between py-1.5 [&>dd]:font-bold' %>

<section class="checkout-summary sticky-note px-[26px] pt-7 pb-[26px] h-fit" id="checkout-summary">
  <span class="tape w-[110px] -ml-[55px] -rotate-3" aria-hidden="true"></span>
  <h2 class="checkout-summary__title font-serif mb-3.5 text-[22px] leading-[1.6]">
    <%= t('spree.order_summary') %>
  </h2>

  <div class="mb-6">
    <% if order.state == 'payment' %>
      <%= render 'orders/coupon_code' %>
    <% end %>
  </div>

  <dl>
    <div class="pb-3 border-b-2 border-dashed border-b-ink">
      <div class="checkout-summary__entry <%= dl_classes %>" id="item-total">
        <dt><%= t('spree.item_total') %>:</dt>
        <dd><%= order.display_item_total.to_html %></dd>
      </div>

      <% if order.line_item_adjustments.nonzero.exists? %>
        <% order.line_item_adjustments.nonzero.promotion.eligible.group_by(&:label).each do |label, adjustments| %>
          <div class="checkout-summary__entry <%= dl_classes %>">
            <dt><%= label %></dt>
            <dd><%= Spree::Money.new(adjustments.sum(&:amount), currency: order.currency).to_html %></dd>
          </div>
        <% end %>
      <% end %>

      <% order.all_adjustments.nonzero.tax.eligible.group_by(&:label).each do |label, adjustments| %>
        <div class="checkout-summary__entry <%= dl_classes %>">
          <dt><%= label %></dt>
          <dd><%= Spree::Money.new(adjustments.sum(&:amount), currency: order.currency).to_html %></dd>
        </div>
      <% end %>

      <% if order.passed_checkout_step?("delivery") && order.shipments.any? %>
        <div class="checkout-summary__entry <%= dl_classes %>">
          <dt><%= t('spree.shipping_total') %>:</dt>
          <dd><%= Spree::Money.new(order.shipments.to_a.sum(&:cost), currency: order.currency).to_html %></dd>
        </div>

        <% if order.shipment_adjustments.nonzero.exists? %>
          <% order.shipment_adjustments.nonzero.promotion.eligible.group_by(&:label).each do |label, adjustments| %>
            <div class="checkout-summary__entry <%= dl_classes %>">
              <dt><%= label %>:</dt>
              <dd><%= Spree::Money.new(adjustments.sum(&:amount), currency: order.currency).to_html %></dd>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% if order.adjustments.nonzero.non_tax.eligible.exists? %>
        <div class="checkout-summary__entry <%= dl_classes %> font-sans-md" id="summary-order-charges">
          <% order.adjustments.nonzero.non_tax.eligible.each do |adjustment| %>
            <dt><%= adjustment.label %>:</dt>
            <dd class="text-red-pen"><%= adjustment.display_amount.to_html %></dd>
          <% end %>
        </div>
      <% end %>

      <% if order.total_applicable_store_credit > 0.0 %>
        <div class="checkout-summary__entry <%= dl_classes %>">
          <dt><%= t('spree.store_credit.store_credit') %>:</dt>
          <dd><%= order.display_total_applicable_store_credit.to_html %></dd>
        </div>
      <% end %>
    </div>

    <div class="checkout-summary__total <%= dl_classes %> items-baseline mt-3 pt-2 border-t-[3px] border-double border-t-ink">
      <dt class="font-bold text-body-md uppercase tracking-[.08em]"><%= t('spree.order_total') %>:</dt>
      <dd class="price-pen text-body-lg"><%= order.display_order_total_after_store_credit.to_html %></dd>
    </div>
  </dl>
</section>

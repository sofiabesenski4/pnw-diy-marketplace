<% order = order_form.object %>

<footer class="cart-footer">
  <%= render 'carts/cart_adjustments' %>
  <p class="cart-footer__total flex justify-between items-baseline mt-3 mb-5 pt-2 border-t-[3px] border-double border-t-ink font-bold text-body-md uppercase tracking-[.08em]">
    <%= t('spree.total') %>: <span class="price-pen text-body-lg normal-case tracking-normal"><%= order.display_total %></span>
  </p>
  <div class="cart-footer__primary-action">
    <%= order_form.button(
      I18n.t('spree.checkout'),
      class: 'button-primary w-full',
      id: 'checkout-link',
      name: :checkout
    ) %>
  </div>
</footer>

<%
  cta_primary_class = 'button-primary'
  cta_secondary_class = 'button-secondary'
  cta_tertiary_class = 'button-secondary bg-paper'
  
  type = type.presence ? type : 'primary'
  cta_class = "#{type == 'primary' && cta_primary_class} #{type == 'secondary' && cta_secondary_class} #{type == 'tertiary' && cta_tertiary_class} #{defined?(additional_classes) ? additional_classes : ''}"
%>

<% if defined?(url) && url != nil %>
 <%= link_to label.html_safe, url, class: cta_class, target: defined?(target) ? target : '_self' %> 
<% else %>
  <%= button_tag(label.html_safe, class: cta_class, id: defined?(id) && id) %>
<% end %>
